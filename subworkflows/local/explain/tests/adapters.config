// The gawk adapters of the variant layers (AVI, OpenCRAVAT) as configured in conf/modules.config (tab-separated fields);
// the prefix comes from the test's meta map so input and output names never collide.
process {
    withName: 'GAWK' {
        ext.args   = '-F "\\t" -v OFS="\\t"'
        ext.prefix = { meta.prefix }
    }
}
