// Module options for tests/activedriverwgs_shards.nf.test (the probe workflow's three aliases)
process {
    withName: 'ADWGS_ONE_SHARD|ADWGS_BOUNDARY' {
        ext.args = '--ref-genome hg38 --shard-size 5000'
    }
    withName: 'ADWGS_SHARD_PER_ID' {
        ext.args = '--ref-genome hg38 --shard-size 1'
    }
}
