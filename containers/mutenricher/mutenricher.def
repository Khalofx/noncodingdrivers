Bootstrap: docker
From: python:3.7.7

# Historical Apptainer recipe of the MutEnricher runtime (python 3.7.7; needs external
# bgzip/tabix). The maintained, self-contained runtime is the Dockerfile in this folder,
# published as ghcr.io/khalofx/noncodingdrivers-mutenricher:1.3.3. See the Dockerfile for
# the legacy Python dependency pins.

%post
    set -eu
    cd /opt
    MUTENRICHER_COMMIT=ddb1863d32c248aeec8797004d13193d836573a1
    curl -L https://github.com/asoltis/MutEnricher/archive/${MUTENRICHER_COMMIT}.tar.gz -o me.tar.gz
    tar -xzf me.tar.gz && rm me.tar.gz
    mv MutEnricher-${MUTENRICHER_COMMIT} MutEnricher
    pip install --no-cache-dir numpy==1.17.3 scipy==1.3.1 cython==0.29.13 pysam==0.15.2
    pip install --no-cache-dir --no-binary cyvcf2 cyvcf2==0.20.0
    cd /opt/MutEnricher/math_funcs && python setup.py build_ext --inplace
    # verify the tool actually starts, so a broken image cannot pass the build
    cd /opt/MutEnricher && python mutEnricher.py --version

%environment
    export MUTENRICHER=/opt/MutEnricher

%labels
    Name mutenricher
    Version 1.3.3
    License MIT
    Source https://github.com/asoltis/MutEnricher
    Revision ddb1863d32c248aeec8797004d13193d836573a1
