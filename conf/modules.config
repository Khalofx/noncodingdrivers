/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

    //
    // Input harmonisation (vcf, sarek and maf rows; subworkflows/local/input_harmonisation)
    //
    withName: 'RENAME_CHROMS' {
        // RefSeq accessions and Ensembl names -> UCSC names of the analysis FASTA
        ext.args   = '--output-type z --write-index=tbi'
        ext.prefix = { "${meta.id}.renamed" }
        publishDir = [ enabled: false ]
    }
    withName: 'MAF_CHECK_VCF' {
        // SNV rows of the MAF as a sites VCF (REF = Reference_Allele) for the assembly check
        ext.args   = '-v mode=check'
        publishDir = [ enabled: false ]
    }
    withName: 'ASSEMBLYCHECK' {
        publishDir = [
            path: { "${params.outdir}/harmonisation/assembly_check" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'MAF_SPLIT' {
        publishDir = [ enabled: false ]
    }
    withName: 'MAF2VCF' {
        publishDir = [
            path: { "${params.outdir}/harmonisation/maf2vcf_skipped" },
            mode: params.publish_dir_mode,
            pattern: '*.skipped.tsv'
        ]
    }
    withName: 'MAF_VCF_SORT' {
        ext.args   = '--output-type z'
        ext.prefix = { "${meta.id}.sorted" }
        publishDir = [ enabled: false ]
    }
    withName: 'PICARD_LIFTOVERVCF' {
        // Records that lift to a contig outside the analysis FASTA (alt and unplaced contigs of
        // the UCSC chain) are rejected with filter NoTarget instead of stopping the task
        ext.args   = '--WARN_ON_MISSING_CONTIG true'
        publishDir = [
            path: { "${params.outdir}/harmonisation/liftover_rejects" },
            mode: params.publish_dir_mode,
            pattern: '*.unlifted.vcf.gz'
        ]
    }
    withName: 'BCFTOOLS_NORM' {
        // split multiallelic records, left-align indels, drop records whose REF disagrees with the FASTA
        ext.args   = '--multiallelics -any --check-ref x --output-type z'
        ext.prefix = { "${meta.id}.norm" }
        publishDir = [ enabled: false ]
    }
    withName: 'PASS_PRIMARY' {
        // PASS or missing FILTER, primary chromosomes; sarek rows keep the tumour column
        ext.args   = { [
            "--apply-filters 'PASS,.'",
            '--targets ' + ((1..22).collect { n -> "chr${n}" } + [ 'chrX', 'chrY' ]).join(','),
            meta.vcf_tumour_id ? "--samples '${meta.vcf_tumour_id}'" : '',
            '--output-type z --write-index=tbi'
        ].findAll { arg -> arg }.join(' ') }
        ext.prefix = { "${meta.id}.pass" }
        publishDir = [
            path: { "${params.outdir}/harmonisation/vcf" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'BCFTOOLS_QUERY' {
        ext.args   = "--format '%CHROM\\t%POS\\t%REF\\t%ALT\\n'"
        ext.prefix = { "${meta.id}.query" }
        publishDir = [ enabled: false ]
    }
    withName: 'QUERY_TO_CANONICAL' {
        ext.args   = { "-v sample='${meta.sample}'" }
        publishDir = [ enabled: false ]
    }

    withName: 'COHORT_CONCAT' {
        // csvtk concat aligns the per-row tables by column name; the result is deduplicated next
        publishDir = [ enabled: false ]
    }

    withName: 'COHORT_DEDUP' {
        // Keep the header and the first copy of every exact duplicate row
        ext.args2  = '\'NR == 1 || !seen[$0]++\''
        publishDir = [
            path: { "${params.outdir}/mutations" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'UNTAR_ONCODRIVEFML_GENOME' {
        publishDir = [ enabled: false ]
    }

    withName: 'ACTIVEDRIVERWGS' {
        ext.args   = { "--ref-genome hg38 --shard-size ${params.adwgs_shard_size}" }
        publishDir = [
            path: { "${params.outdir}/callers/activedriverwgs" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ONCODRIVEFML' {
        // Seed (123), cores and sampling come from the OncodriveFML config file, as in the baseline runs.
        publishDir = [
            path: { "${params.outdir}/callers/oncodrivefml" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ONCODRIVECLUSTL' {
        // Options of the design prototype, written out so an upstream default change cannot alter
        // results: mutation-centred simulation (31 bp), smoothing and clustering windows 11, k-mer 3,
        // 1,000 simulations, no --concatenate (the fragments of a CDS-split element are not joined
        // into one sequence), --seed for reproducible simulations. The IntOGen option set is not used.
        ext.args       = { "-emut ${params.oncodriveclustl_element_mutations} -cmut 2 -sw 11 -cw 11 -kmer 3 -n 1000 -sim mutation_centered -simw 31 --seed ${params.seed}" }
        ext.shard_size = { params.oncodriveclustl_shard_size }
        publishDir = [
            path: { "${params.outdir}/callers/oncodriveclustl" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MUTENRICHER' {
        // QC-only. The option set of the validated baseline QC runs: SNVs only, sample-count
        // statistic, local background, no WAP hotspot test.
        ext.args   = '--snps-only --stat-type nsamples --use-local --no-wap'
        publishDir = [
            path: { "${params.outdir}/callers/mutenricher" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'RUNSUMMARYMQC' {
        ext.args   = { [ "--fdr ${params.fdr_threshold}", params.consensus_callers ? "--consensus-callers ${params.consensus_callers}" : '' ].findAll { arg -> arg }.join(' ') }
        publishDir = [ enabled: false ]   // sections reach the MultiQC report
    }

    withName: 'COMBINEPVALUES' {
        // --callers: the callers whose p-values are combined (--consensus_callers); a named caller
        // that did not run has no column and is skipped, every other p_/q_ column is carried.
        // Without the parameter (configs that do not load nextflow.config) every caller is combined.
        ext.args   = { [ "--method ${params.combination_method}", "--fdr ${params.fdr_threshold}",
                         params.skip_acat ? '--skip-acat' : '',
                         params.consensus_callers ? "--callers ${params.consensus_callers}" : '' ].findAll { arg -> arg }.join(' ') }
        publishDir = [
            path: { "${params.outdir}/consensus" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ELEMENT_COORDS' {
        ext.args2  = '\'BEGIN{FS=OFS="\\t"} {id=$4; if(!(id in s)){o[++n]=id; c[id]=$1; s[id]=$2+0; e[id]=$3+0; f[id]=0} if($2+0<s[id]) s[id]=$2+0; if($3+0>e[id]) e[id]=$3+0; f[id]++} END{print "element_id","chrom","start","end","n_fragments"; for(i=1;i<=n;i++){id=o[i]; print id,c[id],s[id],e[id],f[id]}}\''
        ext.prefix = { "${meta.id}.coords" }
        publishDir = [
            path: { "${params.outdir}/consensus/intermediate" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'HARMONIZECALLS' {
        ext.args = { [ activedriverwgs: '--fields id,pp_element,fdr_element', oncodrivefml: '--fields GENE_ID,P_VALUE,Q_VALUE', oncodriveclustl: '--fields ENSID,P_ANALYTICAL,Q_ANALYTICAL' ][tool] ?: "--fields no_column_mapping_for_${tool}" }
        publishDir = [
            path: { "${params.outdir}/consensus/intermediate" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ANCHOR_JOIN' {
        ext.args   = '--tabs --out-tabs --fields element_id --outer-join --na NA'
        ext.prefix = { "${meta.id}.matched" }
        publishDir = [
            path: { "${params.outdir}/consensus/intermediate" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //
    // Variant flags (VARIANT_FLAGS). Flag, never filter; every gawk program is a format adapter.
    //
    withName: 'VARIANT_SITES|INDEL_ANCHORS|SITES_VCF|FLAGS_BED|ELEMENT_FLAGS_TABLE' {
        ext.args   = '-F "\\t" -v OFS="\\t"'
        publishDir = [ enabled: false ]
    }
    withName: 'VARIANT_SITES' {
        ext.args   = '-F "\\t" -v OFS="\\t" -v mode=sites'
        ext.prefix = { "${meta.id}.sites" }
    }
    withName: 'INDEL_ANCHORS' {
        ext.args   = '-F "\\t" -v OFS="\\t" -v mode=anchors'
        ext.prefix = { "${meta.id}.anchors" }
    }
    withName: 'MASK_BLACKLIST|MASK_SEGDUP|MASK_LOW_MAPPABILITY' {
        ext.args   = '-c'
        publishDir = [ enabled: false ]
    }
    withName: 'MASK_BLACKLIST' {
        ext.prefix = { "${meta.id}.blacklist" }
    }
    withName: 'MASK_SEGDUP' {
        ext.prefix = { "${meta.id}.segdup" }
    }
    withName: 'MASK_LOW_MAPPABILITY' {
        ext.prefix = { "${meta.id}.low_mappability" }
    }
    withName: 'MASK_UMAP' {
        ext.prefix = { "${meta.id}.umap" }
        publishDir = [ enabled: false ]
    }
    withName: 'ANCHOR_BASES' {
        ext.args   = '-nameOnly -tab'
        ext.prefix = { "${meta.id}.anchor_bases" }
        publishDir = [ enabled: false ]
    }
    withName: 'SITES_VCF' {
        ext.prefix = { "${meta.id}.sites" }
    }
    withName: 'SORT_SITES_VCF' {
        ext.args   = '--output-type z --write-index=tbi'
        ext.prefix = { "${meta.id}.sites.sorted" }
        publishDir = [ enabled: false ]
    }
    withName: 'GNOMAD_ANNO' {
        ext.prefix = { "${meta.id}.sites.gnomad" }
        publishDir = [ enabled: false ]
    }
    withName: 'GERMLINE_QUERY' {
        ext.args   = "-f '%ID\\t%INFO/gnomad_filter\\t%INFO/gnomad_af\\t%INFO/gnomad_fafmax_faf95_max\\n'"
        ext.prefix = { "${meta.id}.germline" }
        publishDir = [ enabled: false ]
    }
    withName: 'VARIANT_FLAGS_TABLE' {
        ext.args   = { "-F '\\t' -v OFS='\\t' -v faf_threshold=${params.germline_faf_threshold}" }
        ext.prefix = { "${meta.id}.variant_flags" }
        publishDir = [
            path: { "${params.outdir}/variant_flags" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'FLAGS_BED' {
        ext.prefix = { "${meta.id}.variant_flags" }
    }
    withName: 'ELEMENT_HITS' {
        ext.args   = '-wa -wb'
        ext.prefix = { "${meta.id}.element_hits" }
        publishDir = [ enabled: false ]
    }
    withName: 'CALLABLE_TERRITORY' {
        ext.prefix = 'callable_territory'
        publishDir = [
            path: { "${params.outdir}/references" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'ELEMENT_CALLABLE' {
        ext.prefix = 'elements.callable'
        publishDir = [ enabled: false ]
    }
    withName: 'ELEMENT_FLAGS_TABLE' {
        ext.prefix = { "${meta.id}.element_flags" }
        publishDir = [
            path: { "${params.outdir}/variant_flags" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //
    // Post-filter flags and the evidence table (D33)
    //
    withName: 'POSTFILTERFLAGS' {
        ext.args   = { [
            "--mode ${params.postfilter_mode}",
            "--min-mutations ${params.postfilter_min_mutations}",
            "--min-patients ${params.postfilter_min_patients}",
            "--min-mappable-fraction ${params.postfilter_min_mappable_fraction}",
            "--max-sample-fraction ${params.postfilter_max_sample_fraction}"
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/postfilter" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'WRITEDRIVEREVIDENCE' {
        ext.args   = { [ "--scope ${params.evidence_scope} --fdr ${params.fdr_threshold}",
                         params.consensus_callers ? "--consensus-callers ${params.consensus_callers}" : '' ].findAll { arg -> arg }.join(' ') }
        publishDir = [
            path: { "${params.outdir}/evidence" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //
    // Annotation layers (EXPLAIN). Every gawk program is a format adapter (assets/awk/*.awk).
    //
    withName: 'SIGNIFICANT_BED|MUTATION_BED|MIDPOINT_BED|CANDIDATE_TABLE|NEAREST_TABLE|REGCTX_TABLE|VEP_INPUT|SIGPROFILER_INPUT' {
        ext.args   = '-F "\\t" -v OFS="\\t"'
    }
    withName: 'SIGNIFICANT_BED' {
        ext.prefix = { "${meta.id}.significant" }
        publishDir = [ enabled: false ]
    }
    withName: 'MUTATION_BED' {
        ext.prefix = { "${meta.id}.mutations" }
        publishDir = [ enabled: false ]
    }
    withName: 'MIDPOINT_BED' {
        ext.prefix = { "${meta.id}.midpoints" }
        publishDir = [ enabled: false ]
    }
    withName: 'SORT_SIGNIFICANT' {
        // not published: a cohort without a significant element must leave no candidates/ folder
        ext.prefix = { "${meta.id}.significant" }
        publishDir = [ enabled: false ]
    }
    withName: 'SORT_MIDPOINTS' {
        ext.prefix = { "${meta.id}.midpoints" }
        publishDir = [ enabled: false ]
    }
    withName: 'CANDIDATES' {
        ext.args   = '-wa -wb'
        ext.prefix = { "${meta.id}.candidates" }
        publishDir = [ enabled: false ]
    }
    withName: 'CANDIDATE_TABLE' {
        ext.prefix = { "${meta.id}.candidates" }
        publishDir = [
            path: { "${params.outdir}/candidates" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'GENE_TSS' {
        // GENCODE gene records -> sorted TSS BED (strand-aware); reusable as --gene_tss_bed
        publishDir = [
            path: { "${params.outdir}/references" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'NEAREST_TSS' {
        ext.args   = '-d -t first'
        ext.prefix = { "${meta.id}.nearest_tss" }
        publishDir = [ enabled: false ]
    }
    withName: 'NEAREST_TABLE' {
        ext.prefix = { "${meta.id}.nearest_gene" }
        publishDir = [
            path: { "${params.outdir}/candidates" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'SORT_PEAKS' {
        ext.prefix = { "${meta.id}.peaks" }
        publishDir = [ enabled: false ]
    }
    withName: 'REGCTX_OVERLAP' {
        // peak count, covered bases (peaks merged first) and covered fraction per element fragment
        ext.prefix = { "${meta.id}.${meta.tissue}.${meta.layer}.${meta.accession}.coverage" }
        publishDir = [
            path: { "${params.outdir}/regulatory_context/per_file" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'REGCTX_SIGNAL' {
        // maximum signal of the overlapping peaks; the column follows the file layout (peakFileMeta)
        ext.args   = { "-c ${meta.signal_col} -o max -prec 10" }
        ext.prefix = { "${meta.id}.${meta.tissue}.${meta.layer}.${meta.accession}.signal-c${meta.signal_col}" }
        publishDir = [
            path: { "${params.outdir}/regulatory_context/per_file" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'REGCTX_TABLE' {
        ext.prefix = { "${meta.id}.regulatory_context" }
        publishDir = [
            path: { "${params.outdir}/regulatory_context" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'VEP_INPUT' {
        ext.prefix = { "${meta.id}.vep_input" }
        publishDir = [ enabled: false ]
    }
    withName: 'ENSEMBLVEP_VEP' {
        // The v0.1 command (bin/vep_annotate.py): default-format input, tab output with its field list,
        // offline cache (the module adds --cache --cache_version --dir_cache --assembly --species --fork).
        // Never --regulatory: Regulatory Build 110 (the element catalogue) is the only regulatory build.
        // --run_alphagenome_avi adds AVI_PHRED and AVI_RAW from the AVI plugin of the image (AVI.pm,
        // ensembl-vep 116.3) reading the staged score file (extra_files: the file and its .tbi); the
        // plugin folder is the one holding the vep script. With the layer off the string is the
        // Step 7 one, character for character (tests/vep_ext_args.nf.test).
        ext.args   = { [
            '--offline --format ensembl --tab',
            '--fields "Uploaded_variation,Location,Allele,Gene,SYMBOL,Feature,Feature_type,BIOTYPE,CANONICAL,Consequence,IMPACT,DISTANCE,Existing_variation,gnomADg_AF' + (params.run_alphagenome_avi ? ',AVI_PHRED,AVI_RAW' : '') + '"',
            '--symbol --canonical --biotype --check_existing --af_gnomadg --distance 5000 --force_overwrite',
            params.run_alphagenome_avi
                ? "--dir_plugins \$(dirname \$(readlink -f \$(command -v vep))) --plugin AVI,file=${extra_files.collect { f -> f.name }.find { name -> !name.endsWith('.tbi') }},raw=1"
                : ''
        ].findAll { arg -> arg }.join(' ') }
        ext.prefix = { "${meta.id}.candidates.vep" }
        publishDir = [
            path: { "${params.outdir}/candidates/vep" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'AVI_TABLE|AVI_ELEMENT_SUMMARY' {
        ext.args   = '-F "\\t" -v OFS="\\t"'
        publishDir = [
            path: { "${params.outdir}/candidates/avi" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'AVI_TABLE' {
        // one row per distinct candidate variant with its AVI scores (AlphaGenome via the VEP plugin)
        ext.prefix = { "${meta.id}.avi" }
    }
    withName: 'AVI_ELEMENT_SUMMARY' {
        ext.prefix = { "${meta.id}.avi.element_summary" }
    }
    withName: 'MOTIFBREAKR' {
        publishDir = [
            path: { "${params.outdir}/motifbreakr" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'OPENCRAVAT_INPUT|OPENCRAVAT_TABLE' {
        ext.args   = '-F "\\t" -v OFS="\\t"'
    }
    withName: 'OPENCRAVAT_INPUT' {
        ext.prefix = { "${meta.id}.opencravat_input" }
        publishDir = [ enabled: false ]
    }
    withName: 'OPENCRAVAT' {
        // the annotators baked into the image (containers/opencravat/modules.freeze.json)
        ext.args   = '-a ccre_screen repeat clinvar'
        // published: the joined table (OPENCRAVAT_TABLE), the network audit and the telemetry
        // record; the native text report and SQLite result stay in the work folder
        publishDir = [
            path: { "${params.outdir}/opencravat" },
            mode: params.publish_dir_mode,
            pattern: '*.opencravat.{network,telemetry}.tsv'
        ]
    }
    withName: 'OPENCRAVAT_TABLE' {
        ext.prefix = { "${meta.id}.opencravat" }
        publishDir = [
            path: { "${params.outdir}/opencravat" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'SIGPROFILER_INPUT' {
        ext.prefix = { "${meta.id}.sigprofiler_input" }
        publishDir = [ enabled: false ]
    }
    withName: 'SIGPROFILER' {
        publishDir = [
            path: { "${params.outdir}/qc/sigprofiler" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }


    //
    // Context layers (CONTEXT_LAYERS; all off by default). Annotation only: no layer filters,
    // re-ranks or weights an element. The CONTEXT_LAYERS-qualified selectors keep these settings
    // from reaching the processes of other subworkflows that share a module.
    //
    withName: '.*CONTEXT_LAYERS:COSMICCONTEXT' {
        // counts and provenance (no COSMIC identifiers) in cosmic/; COSMIC records and the
        // licence notice only in cosmic/restricted/
        publishDir = [
            [
                path: { "${params.outdir}/cosmic" },
                mode: params.publish_dir_mode,
                pattern: '*.cosmic.{mutation_summary.tsv,element_summary.tsv,provenance.json}'
            ],
            [
                path: { "${params.outdir}/cosmic/restricted" },
                mode: params.publish_dir_mode,
                pattern: '{*.cosmic.exact_matches.tsv,NOTICE.txt}'
            ]
        ]
    }
    withName: '.*CONTEXT_LAYERS:CANCERGENECONTEXT' {
        publishDir = [
            path: { "${params.outdir}/cancer_genes" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: '.*CONTEXT_LAYERS:PC_TSS' {
        ext.prefix = { "${meta.id}.protein_coding" }
        publishDir = [ enabled: false ]
    }
    withName: '.*CONTEXT_LAYERS:NEAREST_PC_TSS' {
        ext.args   = '-d -t first'
        ext.prefix = { "${meta.id}.nearest_protein_coding_tss" }
        publishDir = [ enabled: false ]
    }
    withName: '.*CONTEXT_LAYERS:RE2G_OVERLAP' {
        // file name carries tissue, biosample and accession for RE2G_LINKS (assets/awk/re2g_links.awk)
        ext.args   = '-wo'
        ext.prefix = { "${meta.id}.${meta.tissue}.${meta.biosample}.${meta.accession}.re2g" }
        publishDir = [ enabled: false ]
    }
    withName: '.*CONTEXT_LAYERS:RE2G_LINKS|.*CONTEXT_LAYERS:CCRE_CELLTYPE_TABLE' {
        ext.args   = '-F "\\t" -v OFS="\\t"'
    }
    withName: '.*CONTEXT_LAYERS:RE2G_LINKS' {
        ext.prefix = { "${meta.id}.enhancer_gene_links" }
        publishDir = [
            path: { "${params.outdir}/enhancer_gene" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: '.*CONTEXT_LAYERS:RE2G_SUMMARY' {
        ext.args   = { "-F '\\t' -v OFS='\\t' -v tissues=${meta.re2g_tissues} -v n_files=${meta.re2g_n_files}" }
        ext.prefix = { "${meta.id}.enhancer_gene_summary" }
        publishDir = [
            path: { "${params.outdir}/enhancer_gene" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: '.*CONTEXT_LAYERS:CCRE_OVERLAP' {
        ext.args   = '-wao'
        ext.prefix = { "${meta.id}.ccre_v4_overlap" }
        publishDir = [ enabled: false ]
    }
    withName: '.*CONTEXT_LAYERS:CCRE_TABLE' {
        ext.args   = '-F "\\t" -v OFS="\\t" -v mode=table'
        ext.prefix = { "${meta.id}.ccre_v4" }
        publishDir = [
            path: { "${params.outdir}/ccre" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: '.*CONTEXT_LAYERS:CCRE_SUMMARY' {
        ext.args   = '-F "\\t" -v OFS="\\t" -v mode=summary'
        ext.prefix = { "${meta.id}.ccre_v4_summary" }
        publishDir = [
            path: { "${params.outdir}/ccre" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: '.*CONTEXT_LAYERS:CCRE_CELLTYPE_OVERLAP' {
        ext.args   = '-wo'
        ext.prefix = { "${meta.id}.${meta.tissue}.${meta.biosample}.${meta.accession}.ccre_celltype" }
        publishDir = [ enabled: false ]
    }
    withName: '.*CONTEXT_LAYERS:CCRE_CELLTYPE_TABLE' {
        ext.prefix = { "${meta.id}.ccre_v4_celltype" }
        publishDir = [
            path: { "${params.outdir}/ccre" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }


    //
    // Null calibration (NULL_CALIBRATION; in-house, D32). The null cohorts run through the same
    // DRIVER_DISCOVERY processes (same options); nothing of them is published except the
    // calibration tables and the simulation counts. Fully qualified selectors take precedence
    // over the process-name selectors above.
    //
    withName: '.*:NULL_CALIBRATION:.*' {
        publishDir = [ enabled: false ]
    }
    withName: '.*:NULL_CALIBRATION:SIMULATENULL' {
        ext.args   = { "--window ${params.null_window}" }
        publishDir = [
            path: { "${params.outdir}/null_calibration/simulation" },
            mode: params.publish_dir_mode,
            pattern: '*.null_summary.tsv'
        ]
    }
    withName: '.*:NULL_CALIBRATION:CALIBRATECALLERS' {
        ext.args   = { "--band ${params.null_lambda_band} --fdr ${params.fdr_threshold}" }
        publishDir = [
            path: { "${params.outdir}/null_calibration" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
