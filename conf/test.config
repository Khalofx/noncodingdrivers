/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run khalofx/noncodingdrivers -profile test,<docker/singularity> --outdir <OUTDIR>

    Synthetic TERT-window cohort from Khalofx/noncodingdrivers-test-datasets: 30 donors,
    TERT promoter C228T planted in 10, six chr5 elements. Both callers run. The OncodriveFML
    score track is a CADD v1.7 subset: CADD scores are free for non-commercial use only
    (Schubach et al. 2024, doi:10.1093/nar/gkad989), and the test-datasets README carries
    the CADD notice. Running this profile accepts the OncodriveFML licence for the test only.
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Synthetic TERT-window cohort: ActiveDriverWGS + OncodriveFML on a CADD subset'

    // Test data: Khalofx/noncodingdrivers-test-datasets (main branch)
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/Khalofx/noncodingdrivers-test-datasets/main/'

    // Input data
    input                       = params.pipelines_testdata_base_path + 'samplesheet/samplesheet_test.csv'
    elements_bed                = params.pipelines_testdata_base_path + 'data/synthetic_tert/elements.bed'

    // Callers
    run_activedriverwgs         = true
    run_oncodrivefml            = true
    accept_oncodrivefml_licence = true
    oncodrivefml_score          = params.pipelines_testdata_base_path + 'data/synthetic_tert/oncodrivefml/cadd_subset.tsv.gz'
    oncodrivefml_conf           = params.pipelines_testdata_base_path + 'data/synthetic_tert/oncodrivefml/oncodrivefml_test.conf'
    oncodrivefml_genome         = params.pipelines_testdata_base_path + 'data/synthetic_tert/oncodrivefml/genome_hg38_chr5_head.tar.gz'

    // Annotation layers: GENCODE v50 TSSs and ENCODE peaks clipped to chr5:1.15-1.45 Mb (tests/data/explain)
    // Variant flags: the real masks clipped to chr5:1-1.4 Mb, gnomAD v4.1 genomes (echtvar) over the
    // same window; the germline flag anchors indels on the chr5 window of the analysis FASTA
    fasta                       = params.pipelines_testdata_base_path + 'data/synthetic_tert/harmonisation/GRCh38.chr5_1-1400000.fa'
    blacklist_bed               = params.pipelines_testdata_base_path + 'data/synthetic_tert/variant_flags/hg38-blacklist.v2.chr5_1-1400000.bed'
    segdup_bed                  = params.pipelines_testdata_base_path + 'data/synthetic_tert/variant_flags/GRCh38_segdups.chr5_1-1400000.bed'
    low_mappability_bed         = params.pipelines_testdata_base_path + 'data/synthetic_tert/variant_flags/GRCh38_lowmappabilityall.chr5_1-1400000.bed'
    umap_bed                    = params.pipelines_testdata_base_path + 'data/synthetic_tert/variant_flags/k100.umap.chr5_1-1400000.bed'
    gnomad_echtvar              = params.pipelines_testdata_base_path + 'data/synthetic_tert/variant_flags/gnomad.v4.1.genomes.chr5_1-1400000.echtvar.zip'
    gene_tss_bed                = "${projectDir}/tests/data/explain/gene_tss.bed"
    run_regulatory_context      = true
    regulatory_peaks_dir        = "${projectDir}/tests/data/explain/peaks"
}
