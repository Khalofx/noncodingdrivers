/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Karakoram site profile (SLURM + Apptainer)
    Use: -profile karakoram
    Project folder: /storage/projects/khalifa.juma/noncodingdrivers
      data/    read-only symlinks to the input data and references
      images/  Apptainer image cache
      local/   site overrides, samplesheets, run_v1.sbatch
      runs/    one launch directory per cohort (work/, results/)
    Values marked VERIFY must be confirmed on the cluster before first use.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    config_profile_name        = 'karakoram'
    config_profile_description = 'Karakoram: one shared 384-core / 1.47 TB node; SLURM partitions cpu (7 d), debug (1 h), long (14 d), gpu (7 d); every job uses cpu; Apptainer only'

    // Validated reference set (checksums in tests/regression/PROVENANCE.md). Always the
    // chr-named FASTA: the institutional RefSeq-named bundle in /storage/datasets/ref_genomes/grch38
    // silently matches nothing. Always the CDS-EXCLUDED catalogue: the CDS-included build
    // leaks coding selection into the non-coding test.
    elements_bed        = '/storage/projects/khalifa.juma/noncodingdrivers/data/refs/GRCh38_regulatory_build.ccre.noncoding.v50.bed'
    oncodrivefml_genome = '/storage/projects/khalifa.juma/noncodingdrivers/data/refs/oncodrivefml_genome/datasets/genomereference/hg38-20161209'
    // VCF/MAF harmonisation and liftover (added with the vcf, sarek and maf entry tiers):
    //   fasta          = '/storage/projects/khalifa.juma/noncodingdrivers/data/refs/hg38.chr.fa'
    //   fai            = '/storage/projects/khalifa.juma/noncodingdrivers/data/refs/hg38.chr.fa.fai'
    //   liftover_chain = '/storage/projects/khalifa.juma/noncodingdrivers/data/refs/liftover/hg19ToHg38.over.chain.gz'
    // CADD GRCh38 v1.7 whole-genome SNVs (+ .tbi), user-supplied; MD5 in tests/regression/PROVENANCE.md
    oncodrivefml_score  = '/storage/projects/khalifa.juma/noncodingdrivers/data/refs/cadd/whole_genome_SNVs.tsv.gz'
    // Annotation layers: GENCODE v50 basic GTF (gene TSSs), ENCODE peaks (49 files, 12 tissues;
    // per-file MD5 in data/refs/encode/PROVENANCE.tsv) and the Ensembl VEP 116 cache (GENCODE v50)
    gencode_gtf          = '/storage/projects/khalifa.juma/noncodingdrivers/data/refs/gencode/gencode.v50.basic.annotation.gtf.gz'
    regulatory_peaks_dir = '/storage/projects/khalifa.juma/noncodingdrivers/data/refs/encode'
    vep_cache            = '/storage/projects/khalifa.juma/noncodingdrivers/data/refs/vep_cache_116'
}

process {
    executor       = 'slurm'
    queue          = 'cpu'
    // VERIFY: the node has 384 cores / 1.47 TB in total.
    resourceLimits = [ cpus: 48, memory: 360.GB, time: 120.h ]

    // ActiveDriverWGS is the long pole (48 CPU / 72 GB, shard size 5000).
    // The image ghcr.io/khalofx/noncodingdrivers-activedriverwgs:1.2.1 carries ActiveDriverWGS
    // 1.2.1 and BSgenome.Hsapiens.UCSC.hg38 1.4.5. For the regression runs it still uses the
    // site R install and prepared library that produced the frozen baseline (image and site R
    // agree to a relative 1.1e-13 on the fixture; OpenBLAS 0.3.26 vs 0.3.32).
    withName: 'ACTIVEDRIVERWGS' {
        queue     = 'cpu'   // 120 h cap fits the 7-day cpu limit; long is not used (D18)
        cpus      = 48
        memory    = 72.GB
        time      = 120.h
        container = null // runs on the site R install, as in the validated baseline runs
        ext.rbin  = '/storage/software/envs/R-4.5.3/bin/Rscript'
        ext.rlib  = '/storage/projects/khalifa.juma/noncodingdrivers/data/rlib'
    }
    withName: 'MOTIFBREAKR' {
        // motifbreakR + calculatePvalue took 47 min for 162 SNVs on 6 cores in the pilot.
        // Image: ghcr.io/khalofx/noncodingdrivers-motifbreakr:2.24.0; the SIF built from
        // containers/motifbreakr/motifbreakr.def is cached under the name Nextflow derives from it.
        cpus   = 6
        memory = 32.GB
        time   = 12.h
    }
    withName: 'ENSEMBLVEP_VEP' {
        cpus   = 4
        memory = 16.GB
    }
    withName: 'SIGPROFILER' {
        // optional QC; extraction (up to 25 signatures x 100 NMF replicates) is slow on CPU.
        // The image installs the GRCh38 reference on first use (compute nodes have internet).
        cpus   = 16
        memory = 64.GB
        time   = 48.h
    }
    // Every other image (ghcr.io/khalofx/noncodingdrivers-*, the Seqera images of the nf-core
    // modules) is pulled into apptainer.cacheDir on first use.
}

executor {
    queueSize       = 20
    submitRateLimit = '10/1min'
    // SLURM job names follow the project rule noncodingdrivers-<process>-<tag>
    jobName         = { "noncodingdrivers-${task.process.tokenize(':')[-1].toLowerCase()}-${task.tag ?: task.index}".replaceAll(/[^A-Za-z0-9._-]/, '_') }
}

apptainer {
    enabled    = true
    autoMounts = true
    runOptions = '-B /storage'      // also makes the data/ symlink targets visible in tasks
    cacheDir   = '/storage/projects/khalifa.juma/noncodingdrivers/images'
    // /etc/profile.d exports APPTAINER_CACHEDIR to a shared folder this account cannot write;
    // the launcher (local/run_v1.sbatch) exports APPTAINER_CACHEDIR/APPTAINER_TMPDIR under images/.
}
