/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run khalofx/noncodingdrivers -profile test_full,<docker/singularity/site> \
            --reference_base <dir> --oncodrivefml_score <CADD whole_genome_SNVs.tsv.gz> --outdir <OUTDIR>

    Input: SYNTH-NC, a synthetic genome-wide cohort (60 donors, 231,472 SNVs on chr1-22/X, seeded)
    with five planted non-coding drivers and one spectrum decoy; the answer key is
    data/synth_nc/SYNTH-NC.truth.json in the test-datasets repository. References are the
    full-size GRCh38 set of the datasheet assets/references/GRCh38.yml under --reference_base
    (docs/references.md); CADD is user-supplied (non-commercial licence). The regression cohorts
    are not redistributed and are run on Karakoram only (tests/regression/).
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'SYNTH-NC: synthetic genome-wide cohort with five planted non-coding drivers'

    // Test data: Khalofx/noncodingdrivers-test-datasets (main branch)
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/Khalofx/noncodingdrivers-test-datasets/main/'

    // Input data for full size test
    input                       = params.pipelines_testdata_base_path + 'samplesheet/samplesheet_synth_nc.csv'
    genome                      = 'GRCh38'

    run_activedriverwgs         = true
    run_oncodrivefml            = true
    accept_oncodrivefml_licence = true
}
