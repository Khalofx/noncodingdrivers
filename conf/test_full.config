/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run khalofx/noncodingdrivers -profile test_full,<docker/singularity> --outdir <OUTDIR>

    No public full-size cohort can be redistributed (the regression cohorts are controlled
    access and run on Karakoram only; see tests/regression/). Until a public full-size
    dataset is added, this profile runs the same synthetic cohort as the test profile.
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Synthetic TERT-window cohort (no public full-size cohort can be redistributed)'

    // Test data: Khalofx/noncodingdrivers-test-datasets (main branch)
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/Khalofx/noncodingdrivers-test-datasets/main/'

    // Input data for full size test
    input                       = params.pipelines_testdata_base_path + 'samplesheet/samplesheet_test.csv'
    elements_bed                = params.pipelines_testdata_base_path + 'data/synthetic_tert/elements.bed'

    run_activedriverwgs         = true
    run_oncodrivefml            = true
    accept_oncodrivefml_licence = true
    oncodrivefml_score          = params.pipelines_testdata_base_path + 'data/synthetic_tert/oncodrivefml/cadd_subset.tsv.gz'
    oncodrivefml_conf           = params.pipelines_testdata_base_path + 'data/synthetic_tert/oncodrivefml/oncodrivefml_test.conf'
    oncodrivefml_genome         = params.pipelines_testdata_base_path + 'data/synthetic_tert/oncodrivefml/genome_hg38_chr5_head.tar.gz'
}
