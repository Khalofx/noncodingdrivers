{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/khalofx/noncodingdrivers/main/assets/schema_input.json",
    "title": "khalofx/noncodingdrivers pipeline - params.input schema",
    "description": "One row per input: a canonical mutation table (mutations), a somatic VCF (vcf, or sarek for nf-core/sarek output) or a MAF (maf)",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$",
                "errorMessage": "sample must be provided and may contain only letters, digits, '.', '_' and '-'",
                "meta": ["id"]
            },
            "entry": {
                "type": "string",
                "enum": ["mutations", "vcf", "sarek", "maf"],
                "errorMessage": "entry must be one of: mutations, vcf, sarek, maf",
                "meta": ["entry"]
            },
            "cohort": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$",
                "errorMessage": "cohort may contain only letters, digits, '.', '_' and '-'; empty means the row is its own cohort",
                "meta": ["cohort"]
            },
            "cancer_type": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$",
                "errorMessage": "cancer_type may contain only letters, digits, '.', '_' and '-'",
                "meta": ["cancer_type"]
            },
            "assembly": {
                "type": "string",
                "enum": ["GRCh38", "hg38", "GRCh37", "hg19"],
                "default": "GRCh38",
                "errorMessage": "assembly must be GRCh38 or hg38 (GRCh37/hg19 rows need liftover, which is not available in this version)",
                "meta": ["assembly_declared"]
            },
            "vcf_tumour_id": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "vcf_tumour_id cannot contain spaces",
                "meta": ["vcf_tumour_id"]
            },
            "mutations": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.(tsv|txt)(\\.gz)?$",
                "errorMessage": "mutations must be a .tsv/.txt(.gz) canonical table with columns sample chrom pos ref alt vtype"
            },
            "vcf": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.vcf\\.gz$",
                "errorMessage": "vcf must be a bgzip-compressed VCF ending in .vcf.gz (bgzip calls.vcf; tabix -p vcf calls.vcf.gz)"
            },
            "index": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.(tbi|csi)$",
                "errorMessage": "index must end in .tbi or .csi"
            },
            "maf": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.maf(\\.gz)?$",
                "errorMessage": "maf must end in .maf or .maf.gz"
            }
        },
        "required": ["sample", "entry"],
        "allOf": [
            {
                "if": {
                    "properties": {
                        "entry": {
                            "const": "mutations"
                        }
                    }
                },
                "then": {
                    "required": ["mutations"]
                }
            },
            {
                "if": {
                    "properties": {
                        "entry": {
                            "enum": ["vcf", "sarek"]
                        }
                    }
                },
                "then": {
                    "required": ["vcf"]
                }
            },
            {
                "if": {
                    "properties": {
                        "entry": {
                            "const": "maf"
                        }
                    }
                },
                "then": {
                    "required": ["maf"]
                }
            },
            {
                "if": {
                    "properties": {
                        "entry": {
                            "const": "sarek"
                        }
                    }
                },
                "then": {
                    "required": ["vcf", "vcf_tumour_id"]
                }
            }
        ]
    },
    "uniqueEntries": ["sample"]
}
