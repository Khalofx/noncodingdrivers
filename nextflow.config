/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    khalofx/noncodingdrivers Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // Input options
    input                      = null

    // Reference options (GRCh38). The datasheet assets/references/<genome>.yml supplies every
    // reference below; an explicit parameter wins over its datasheet value.
    genome                     = 'GRCh38'
    references                 = null   // custom datasheet (YAML) instead of assets/references/<genome>.yml
    reference_base             = null   // directory the datasheet paths ${reference_base}/... are relative to
    elements_bed               = null   // CDS-excluded element catalogue, headerless BED (chrom start end id)
    fasta                      = null   // GRCh38 FASTA, UCSC names (vcf, sarek and maf rows)
    fasta_fai                  = null   // default: <fasta>.fai
    fasta_dict                 = null   // default: <fasta without extension>.dict (liftover only)
    rename_chrs                = null   // bcftools --rename-chrs map; default: datasheet rename_map

    // Input harmonisation (vcf, sarek and maf rows)
    assembly_min_match         = 0.99   // stop a row with ASSEMBLY_MISMATCH below this REF match fraction
    assembly_min_records       = 50     // fewer checkable SNVs: the declared assembly is used (low_evidence)
    allow_hg19_liftover        = false  // GRCh37/hg19 rows are lifted to GRCh38 only when true
    liftover_chain             = null   // hg19 -> GRCh38 UCSC chain; default: datasheet liftover_chain_from_hg19
    liftover_source_fasta      = null   // hg19 FASTA, UCSC names; default: datasheet liftover_source_fasta
    liftover_source_fai        = null   // default: <liftover_source_fasta>.fai

    // Caller options
    run_activedriverwgs        = true
    run_oncodrivefml           = false  // licence-gated: needs accept_oncodrivefml_licence
    accept_oncodrivefml_licence = false
    oncodrivefml_score         = null   // user-supplied CADD GRCh38 v1.7 SNV track (bgzip + .tbi)
    oncodrivefml_conf          = null   // default: assets/oncodrivefml.CADD_GRCh38.conf
    oncodrivefml_genome        = null   // offline bgdata hg38 genome: directory or .tar.gz
    adwgs_shard_size           = 5000   // elements per ActiveDriverWGS shard; FDR is recomputed over all shards
    run_mutenricher            = false  // QC-only; reads per-sample VCFs (vcf, sarek, maf rows)
    mutenricher_mappable_regions = null // GRCh38 callable/mappable BED (bgzip + .tbi)

    // Consensus options
    combination_method         = 'ebm'  // ebm | acat: which combination sets consensus_q (both are published)
    fdr_threshold              = 0.1
    skip_acat                  = false  // true when the ACAT package is unavailable (-profile conda)

    // Variant flags (flag, never filter: the mutation table and the consensus are unchanged)
    run_variant_flags          = true   // mask and germline flags per mutation row, element-level fractions
    blacklist_bed              = null   // ENCODE Blacklist v2 (hg38); default: datasheet blacklist_bed
    segdup_bed                 = null   // GIAB v3.6 GRCh38 segmental duplications; default: datasheet segdup_bed
    low_mappability_bed        = null   // GIAB v3.6 GRCh38 low mappability (all); default: datasheet low_mappability_bed
    umap_bed                   = null   // Umap k100 single-read mappability (hg38); default: datasheet umap_bed
    gnomad_echtvar             = null   // gnomAD v4.1 genomes echtvar archive; default: datasheet gnomad_echtvar
    skip_germline_flags        = false  // true: no gnomAD lookup, germline columns NA
    germline_faf_threshold     = 0.001  // germline_pop_common: gnomAD PASS and fafmax_faf95_max above this

    // Post-filter flags and the long-form evidence table (D33; tiers are assigned downstream)
    run_driver_evidence        = true   // POSTFILTERFLAGS and WRITEDRIVEREVIDENCE (evidence/<cohort>.driver_evidence.tsv)
    postfilter_mode            = 'flag_only' // flag_only | pcawg (adds q_postfilter; consensus_q is never changed)
    postfilter_min_mutations   = 3
    postfilter_min_patients    = 3
    postfilter_min_mappable_fraction = 0.5 // share of an element's mutations outside GIAB low mappability
    postfilter_max_sample_fraction   = 0.5 // largest share of an element's mutations from one patient
    evidence_scope             = 'nominal' // nominal (any p < 0.01 or consensus_q < 0.25) | all

    // Null calibration (in-house, D32; reported only, never changes a p-value)
    run_null_calibration       = false  // SIMULATENULL copies re-run through the same callers; ~ one observed run per replicate
    null_replicates            = 3
    null_window                = 50000  // each SNV moves within +/- this many bases, same trinucleotide, same patient
    null_lambda_band           = '0.8,1.2' // provisional band of the null inflation factor (fixed in Step 6)
    seed                       = 1      // replicate r uses seed + r

    // Annotation layers (none of them filters or re-ranks a candidate)
    gencode_gtf                = null   // GENCODE GTF (GRCh38): gene TSSs for the nearest-gene table
    gene_tss_bed               = null   // pre-built sorted TSS BED (assets/awk/gene_tss.awk); used instead of gencode_gtf
    run_regulatory_context     = false  // ENCODE peak overlap per tissue and layer
    regulatory_peaks_dir       = null   // <dir>/<tissue>/<layer>.<accession>.bed.gz
    run_vep                    = false  // Ensembl VEP on candidate mutations (offline cache)
    vep_cache                  = null   // VEP cache directory holding homo_sapiens/<version>_GRCh38
    vep_cache_version          = 116
    run_motifbreakr            = false  // motifbreakR on candidate SNVs (annotation only)
    jaspar_motifs              = null   // default: assets/motifs/jaspar_core_vertebrates_2026.pfm
    run_sigprofiler            = false  // optional cohort-level signature QC (SigProfiler)
    sigprofiler_genome         = null   // pre-installed SigProfilerMatrixGenerator GRCh38 genome (offline nodes)

    // MultiQC options
    multiqc_config             = null
    multiqc_title              = null
    multiqc_logo               = null
    max_multiqc_email_size     = '25.MB'
    multiqc_methods_description = null

    // Boilerplate options
    outdir                       = null
    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // Config options
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true
}

// Backwards compatibility for publishDir syntax
outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm64 {
        process.arch            = 'arm64'
        // TODO https://github.com/nf-core/modules/issues/6694
        // For now if you're using arm64 you have to use wave for the sake of the maintainers
        // wave profile
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
    karakoram { includeConfig 'conf/karakoram.config' }
    test      { includeConfig 'conf/test.config'      }
    test_full { includeConfig 'conf/test_full.config' }
}

// Load nf-core custom profiles from different institutions

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load khalofx/noncodingdrivers custom profiles from different institutions.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"


// Load khalofx/noncodingdrivers custom profiles from different institutions.
// includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/pipeline/noncodingdrivers.config" : "/dev/null"

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'



// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'khalofx/noncodingdrivers'
    contributors    = [
        [
            name: 'Khalifa Juma',
            affiliation: '',
            email: '',
            github: 'Khalofx',
            contribution: ['author', 'maintainer'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: '0009-0005-5227-5772'
        ],
    ]
    homePage        = 'https://github.com/khalofx/noncodingdrivers'
    description     = """Cohort-level discovery and explanation of candidate non-coding regulatory driver elements from pre-called somatic variants"""
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=25.10.4'
    version         = '1.0.0dev'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.5.1' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

validation {
    defaultIgnoreParams = ["genomes"]
    monochromeLogs = params.monochrome_logs
}
// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
