params {
    outdir           = 'results'
    publish_dir_mode = 'copy'
    fdr_threshold    = 0.1
    postfilter_mode                  = 'flag_only'
    postfilter_min_mutations         = 3
    postfilter_min_patients          = 3
    postfilter_min_mappable_fraction = 0.5
    postfilter_max_sample_fraction   = 0.5
}
// The pipeline's module options (gawk adapters, tool arguments, prefixes); the defaults above are
// those of nextflow.config for the parameters these options read
includeConfig '../../../../conf/modules.config'
