params {
    // element ids per OncodriveCLUSTL run (ext.shard_size); a test sets 2 to exercise the shard merge
    clustl_shard_size = 5000
}

process {
    withName: 'ONCODRIVECLUSTL' {
        ext.args       = '-emut 2 -cmut 2 -sw 11 -cw 11 -kmer 3 -n 1000 -sim mutation_centered -simw 31 --seed 1'
        ext.shard_size = { params.clustl_shard_size }
    }
}
