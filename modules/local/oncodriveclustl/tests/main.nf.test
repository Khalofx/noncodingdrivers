nextflow_process {

    name "Test Process ONCODRIVECLUSTL"
    script "../main.nf"
    process "ONCODRIVECLUSTL"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "oncodriveclustl"

    test("synthetic TERT cohort - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', cohort:'test', assembly:'GRCh38' ],
                    file("${projectDir}/tests/data/activedriverwgs/mutations.tsv", checkIfExists: true),
                    file("${projectDir}/tests/data/oncodriveclustl/elements.prefiltered.bed", checkIfExists: true)
                ]
                // bgdata reads chromosome files by offset: the first 1.4 Mb of hg38 chr5 covers every fixture element
                input[1] = file("${projectDir}/tests/data/oncodrivefml/genome_hg38_chr5_head", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }
    }

    // Real run on every fixture row (below-cutoff, empty and unplaced elements included); the task keeps
    // the rows of the ids with >= -emut SNVs. Seeded (--seed 1); the integer counts and cluster
    // coordinates are snapshotted, scores and p-values asserted to a tolerance.
    test("synthetic TERT cohort - all catalogue rows") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', cohort:'test', assembly:'GRCh38' ],
                    file("${projectDir}/tests/data/activedriverwgs/mutations.tsv", checkIfExists: true),
                    file("${projectDir}/tests/data/oncodriveclustl/elements.bed", checkIfExists: true)
                ]
                // bgdata reads chromosome files by offset: the first 1.4 Mb of hg38 chr5 covers every fixture element
                input[1] = file("${projectDir}/tests/data/oncodrivefml/genome_hg38_chr5_head", checkIfExists: true)
                """
            }
        }

        then {
            // Platform-independent checks: the integer counts and coordinates exactly, scores and
            // p-values to a relative tolerance (their last digits depend on the CPU's floating-point
            // code paths, so the tables are not compared by md5)
            def table  = { f -> def t = path(f).readLines(); def h = t[0].tokenize('\t')
                               [ h, t.drop(1).collect { line -> def x = line.split('\t', -1); [ h, x.toList() ].transpose().collectEntries() } ] }
            def close  = { String x, double y, double rel -> x && Math.abs((x as double) - y) <= rel * Math.abs(y) }
            def counts = [ 'TERT_promoter_fixture,612,10,10,1', 'elem_B,800,2,0,0', 'elem_D,700,2,0,0', 'elem_split,400,2,0,0' ]
            def ccoord = [ 'TERT_promoter_fixture,1295113,1295113,1295113,1,10,10' ]
            def (eh, er) = table(process.out.results[0][1])
            def (ch, cr) = table(process.out.clusters[0][1])
            def tert     = er.find { r -> r.ENSID == 'TERT_promoter_fixture' }
            assert process.success
            assertAll(
                // the task keeps the rows of the ids with >= -emut (2) SNVs: elem_A, elem_C, elem_E (one SNV),
                // elem_empty (none) and elem_unplaced (off the primary chromosomes) never reach OncodriveCLUSTL
                { assert eh == [ 'SYMBOL', 'ENSID', 'CGC', 'CHROMOSOME', 'STRAND', 'LENGTH', 'TOTAL_MUT', 'CLUSTERED_MUT', 'CLUSTERS', 'SIM_CLUSTERS', 'SCORE', 'P_EMPIRICAL', 'Q_EMPIRICAL', 'P_ANALYTICAL', 'Q_ANALYTICAL', 'P_TOPCLUSTER', 'Q_TOPCLUSTER' ] },
                { assert er.collect { r -> [ r.ENSID, r.LENGTH, r.TOTAL_MUT, r.CLUSTERED_MUT, r.CLUSTERS ].join(',') } == counts },
                { assert er.every { r -> r.CGC == 'Non Available' } },
                // only the TERT promoter has an observed cluster (tested); one tested element: q = p
                { assert er.findAll { r -> r.P_ANALYTICAL }.collect { r -> r.ENSID } == [ 'TERT_promoter_fixture' ] },
                { assert close(tert.SCORE, 1000.0d, 1e-9) && close(tert.P_EMPIRICAL, 0.001d, 1e-9) },
                { assert close(tert.P_ANALYTICAL, 5.846e-14d, 1e-2) && close(tert.P_TOPCLUSTER, 2.348e-10d, 1e-2) },
                { assert tert.Q_ANALYTICAL == tert.P_ANALYTICAL && tert.Q_TOPCLUSTER == tert.P_TOPCLUSTER },
                { assert cr.collect { r -> [ r.ENSID, r.COORDINATES, r.MAX_COORD, r.WIDTH, r.N_MUT, r.N_SAMPLES ].join(',') } == ccoord },
                { assert close(cr[0].SCORE, 1000.0d, 1e-9) && close(cr[0].P, 2.348e-10d, 1e-2) && cr[0].RANK == '1' },
                { assert snapshot(counts, ccoord, process.out.versions_oncodriveclustl).match() }
            )
        }
    }

    // Prefilter idempotence: the rows of the analysed ids only (what bin/oncodriveclustl_prefilter.py
    // keeps) give the same counts, clusters and p-values as every catalogue row (test above).
    test("synthetic TERT cohort - prefiltered rows") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', cohort:'test', assembly:'GRCh38' ],
                    file("${projectDir}/tests/data/activedriverwgs/mutations.tsv", checkIfExists: true),
                    file("${projectDir}/tests/data/oncodriveclustl/elements.prefiltered.bed", checkIfExists: true)
                ]
                // bgdata reads chromosome files by offset: the first 1.4 Mb of hg38 chr5 covers every fixture element
                input[1] = file("${projectDir}/tests/data/oncodrivefml/genome_hg38_chr5_head", checkIfExists: true)
                """
            }
        }

        then {
            // Platform-independent checks: the integer counts and coordinates exactly, scores and
            // p-values to a relative tolerance (their last digits depend on the CPU's floating-point
            // code paths, so the tables are not compared by md5)
            def table  = { f -> def t = path(f).readLines(); def h = t[0].tokenize('\t')
                               [ h, t.drop(1).collect { line -> def x = line.split('\t', -1); [ h, x.toList() ].transpose().collectEntries() } ] }
            def close  = { String x, double y, double rel -> x && Math.abs((x as double) - y) <= rel * Math.abs(y) }
            def counts = [ 'TERT_promoter_fixture,612,10,10,1', 'elem_B,800,2,0,0', 'elem_D,700,2,0,0', 'elem_split,400,2,0,0' ]
            def ccoord = [ 'TERT_promoter_fixture,1295113,1295113,1295113,1,10,10' ]
            def (eh, er) = table(process.out.results[0][1])
            def (ch, cr) = table(process.out.clusters[0][1])
            def tert     = er.find { r -> r.ENSID == 'TERT_promoter_fixture' }
            assert process.success
            assertAll(
                // prefilter idempotence: the same rows, counts, clusters and p-values as with every catalogue row
                { assert eh == [ 'SYMBOL', 'ENSID', 'CGC', 'CHROMOSOME', 'STRAND', 'LENGTH', 'TOTAL_MUT', 'CLUSTERED_MUT', 'CLUSTERS', 'SIM_CLUSTERS', 'SCORE', 'P_EMPIRICAL', 'Q_EMPIRICAL', 'P_ANALYTICAL', 'Q_ANALYTICAL', 'P_TOPCLUSTER', 'Q_TOPCLUSTER' ] },
                { assert er.collect { r -> [ r.ENSID, r.LENGTH, r.TOTAL_MUT, r.CLUSTERED_MUT, r.CLUSTERS ].join(',') } == counts },
                { assert er.every { r -> r.CGC == 'Non Available' } },
                // only the TERT promoter has an observed cluster (tested); one tested element: q = p
                { assert er.findAll { r -> r.P_ANALYTICAL }.collect { r -> r.ENSID } == [ 'TERT_promoter_fixture' ] },
                { assert close(tert.SCORE, 1000.0d, 1e-9) && close(tert.P_EMPIRICAL, 0.001d, 1e-9) },
                { assert close(tert.P_ANALYTICAL, 5.846e-14d, 1e-2) && close(tert.P_TOPCLUSTER, 2.348e-10d, 1e-2) },
                { assert tert.Q_ANALYTICAL == tert.P_ANALYTICAL && tert.Q_TOPCLUSTER == tert.P_TOPCLUSTER },
                { assert cr.collect { r -> [ r.ENSID, r.COORDINATES, r.MAX_COORD, r.WIDTH, r.N_MUT, r.N_SAMPLES ].join(',') } == ccoord },
                { assert close(cr[0].SCORE, 1000.0d, 1e-9) && close(cr[0].P, 2.348e-10d, 1e-2) && cr[0].RANK == '1' },
                { assert snapshot(counts, ccoord).match() }
            )
        }
    }

    // Shards of two element ids: the signature of the first shard is reused (-sig), the q-values are
    // recomputed over both shards and the observed cluster counts and scores do not depend on the layout.
    test("synthetic TERT cohort - prefiltered rows, shards of two ids") {

        when {
            params {
                clustl_shard_size = 2
            }
            process {
                """
                input[0] = [
                    [ id:'test', cohort:'test', assembly:'GRCh38' ],
                    file("${projectDir}/tests/data/activedriverwgs/mutations.tsv", checkIfExists: true),
                    file("${projectDir}/tests/data/oncodriveclustl/elements.prefiltered.bed", checkIfExists: true)
                ]
                // bgdata reads chromosome files by offset: the first 1.4 Mb of hg38 chr5 covers every fixture element
                input[1] = file("${projectDir}/tests/data/oncodrivefml/genome_hg38_chr5_head", checkIfExists: true)
                """
            }
        }

        then {
            // Platform-independent checks: the integer counts and coordinates exactly, scores and
            // p-values to a relative tolerance (their last digits depend on the CPU's floating-point
            // code paths, so the tables are not compared by md5)
            def table  = { f -> def t = path(f).readLines(); def h = t[0].tokenize('\t')
                               [ h, t.drop(1).collect { line -> def x = line.split('\t', -1); [ h, x.toList() ].transpose().collectEntries() } ] }
            def close  = { String x, double y, double rel -> x && Math.abs((x as double) - y) <= rel * Math.abs(y) }
            def (eh, er) = table(process.out.results[0][1])
            def obs  = er.collect { r -> [ r.ENSID, r.TOTAL_MUT, r.CLUSTERED_MUT, r.CLUSTERS ].join(',') }.sort()
            def tert = er.find { r -> r.ENSID == 'TERT_promoter_fixture' }
            def log  = path(process.out.log[0][1]).text
            assert process.success
            assertAll(
                { assert er.size() == 4 },
                { assert log.contains('== out.00001') && log.contains('== out.00002') },
                // the observed counts and the score do not depend on the layout; with one tested element in
                // its shard, the q-values over both shards equal its p-values
                { assert obs == [ 'TERT_promoter_fixture,10,10,1', 'elem_B,2,0,0', 'elem_D,2,0,0', 'elem_split,2,0,0' ] },
                { assert close(tert.SCORE, 1000.0d, 1e-9) && tert.Q_ANALYTICAL == tert.P_ANALYTICAL },
                { assert close(tert.P_ANALYTICAL, 5.846e-14d, 1e-2) },
                { assert snapshot(obs).match() }
            )
        }
    }
}
