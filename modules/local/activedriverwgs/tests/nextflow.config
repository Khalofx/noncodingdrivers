process {
    withName: 'ACTIVEDRIVERWGS' {
        ext.args = '--ref-genome hg38 --shard-size 5000'
        // Site-R escape hatch for running the real test before the image exists (unset in CI).
        ext.rbin = { System.getenv('NCD_ADWGS_RBIN') ?: null }
        ext.rlib = { System.getenv('NCD_ADWGS_RLIB') ?: null }
    }
}
