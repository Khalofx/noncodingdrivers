nextflow_process {

    name "Test Process ONCODRIVEFML"
    script "../main.nf"
    process "ONCODRIVEFML"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "oncodrivefml"

    test("homo_sapiens - mutations.tsv - elements.bed - cadd_subset - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', cohort:'test', assembly:'GRCh38' ],
                    file("${projectDir}/tests/data/activedriverwgs/mutations.tsv", checkIfExists: true)
                ]
                input[1] = [
                    [ id:'elements', assembly:'GRCh38' ],
                    file("${projectDir}/tests/data/activedriverwgs/elements.bed", checkIfExists: true)
                ]
                input[2] = [
                    [ id:'cadd_subset' ],
                    file("${projectDir}/tests/data/oncodrivefml/cadd_subset.tsv.gz", checkIfExists: true),
                    file("${projectDir}/tests/data/oncodrivefml/cadd_subset.tsv.gz.tbi", checkIfExists: true)
                ]
                input[3] = file("${projectDir}/tests/data/oncodrivefml/oncodrivefml_test.conf", checkIfExists: true)
                // Karakoram: NCD_OFML_GENOME points at the offline bgdata hg38 genome; CI uses bgdata's cache.
                input[4] = System.getenv('NCD_OFML_GENOME') ? file(System.getenv('NCD_OFML_GENOME'), checkIfExists: true) : []
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }
    }

    // Real run on the committed synthetic fixture with a CADD v1.7 subset over the fixture
    // elements. OncodriveFML samples with the seed in the config (123); only the table shape,
    // the fixture elements and the versions are asserted, not the p-values.
    test("homo_sapiens - mutations.tsv - elements.bed - cadd_subset") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', cohort:'test', assembly:'GRCh38' ],
                    file("${projectDir}/tests/data/activedriverwgs/mutations.tsv", checkIfExists: true)
                ]
                input[1] = [
                    [ id:'elements', assembly:'GRCh38' ],
                    file("${projectDir}/tests/data/activedriverwgs/elements.bed", checkIfExists: true)
                ]
                input[2] = [
                    [ id:'cadd_subset' ],
                    file("${projectDir}/tests/data/oncodrivefml/cadd_subset.tsv.gz", checkIfExists: true),
                    file("${projectDir}/tests/data/oncodrivefml/cadd_subset.tsv.gz.tbi", checkIfExists: true)
                ]
                input[3] = file("${projectDir}/tests/data/oncodrivefml/oncodrivefml_test.conf", checkIfExists: true)
                // Karakoram: NCD_OFML_GENOME points at the offline bgdata hg38 genome; CI uses bgdata's cache.
                input[4] = System.getenv('NCD_OFML_GENOME') ? file(System.getenv('NCD_OFML_GENOME'), checkIfExists: true) : []
                """
            }
        }

        then {
            def lines  = path(process.out.results[0][1]).readLines()
            def header = lines[0].tokenize('\t')
            assert process.success
            assertAll(
                { assert header.containsAll(['GENE_ID', 'P_VALUE', 'Q_VALUE']) },
                { assert lines.any { line -> line.startsWith('TERT_promoter_fixture\t') } },
                { assert !lines.any { line -> line.startsWith('elem_unplaced\t') } },
                { assert snapshot(
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }
}
