nextflow_process {

    name "Test Process COMBINEPVALUES"
    script "../main.nf"
    process "COMBINEPVALUES"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "combinepvalues"

    test("synthetic matched table - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', cohort:'test', assembly:'GRCh38' ],
                    file("${projectDir}/tests/data/combinepvalues/matched_test.tsv", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }
    }

    // Real run: needs the COMBINEPVALUES image (ACAT installed). bin/combine_pvalues.R reproduces
    // combination_check.R on the three release tables (Step 3.7; tests/regression/PROVENANCE.md).
    test("synthetic matched table") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', cohort:'test', assembly:'GRCh38' ],
                    file("${projectDir}/tests/data/combinepvalues/matched_test.tsv", checkIfExists: true)
                ]
                """
            }
        }

        then {
            def lines = path(process.out.consensus[0][1]).readLines()
            def cols  = lines[0].tokenize('\t')
            assert process.success
            assertAll(
                { assert [ 'ebm_q', 'acat_q', 'rra_q', 'vote_count', 'consensus_q', 'is_consensus' ].every { c -> c in cols } },
                { assert lines.size() == 6 },
                { assert snapshot(process.out.consensus).match() }   // deterministic: md5 is stable
            )
        }
    }
}
