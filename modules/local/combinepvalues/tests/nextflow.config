params {
    // --callers for the tests that name the combined callers; null runs without --callers
    combine_callers = null
}

process {
    withName: 'COMBINEPVALUES' {
        ext.args = { params.combine_callers ? "--method ebm --fdr 0.1 --callers ${params.combine_callers}" : '--method ebm --fdr 0.1' }
    }
}
