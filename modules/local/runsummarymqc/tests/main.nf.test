nextflow_process {

    name "Test Process RUNSUMMARYMQC"
    script "../main.nf"
    process "RUNSUMMARYMQC"

    tag "modules"
    tag "modules_local"
    tag "runsummarymqc"

    test("synthetic consensus - two caller tables - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', cohort:'test', assembly:'GRCh38' ],
                    file("${projectDir}/tests/data/runsummarymqc/test.consensus.tsv", checkIfExists: true),
                    [ file("${projectDir}/tests/data/harmonizecalls/test.activedriverwgs.tsv", checkIfExists: true),
                      file("${projectDir}/tests/data/harmonizecalls/test.oncodrivefml.tsv", checkIfExists: true) ]
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("synthetic consensus - two caller tables") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', cohort:'test', assembly:'GRCh38' ],
                    file("${projectDir}/tests/data/runsummarymqc/test.consensus.tsv", checkIfExists: true),
                    [ file("${projectDir}/tests/data/harmonizecalls/test.activedriverwgs.tsv", checkIfExists: true),
                      file("${projectDir}/tests/data/harmonizecalls/test.oncodrivefml.tsv", checkIfExists: true) ]
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert process.out.sections[0][1].collect { f -> file(f).name }.sort() ==
                         [ 'test_noncodingdrivers_caller_coverage_mqc.yaml', 'test_noncodingdrivers_caller_rows_mqc.yaml',
                           'test_noncodingdrivers_overview_mqc.yaml' ] },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
