params {
    outdir                     = 'results'
    publish_dir_mode           = 'copy'
    hypermutator_filter        = 'intogen'
    // the fixture is small: 15 stands in for the WGS value of 10,000
    hypermutator_min_mutations = 15
    hypermutator_iqr_factor    = 1.5
}
// The pipeline's module options; the defaults above replace those of nextflow.config for the test
includeConfig '../../../../conf/modules.config'
